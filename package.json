{
  "name": "expert-ai-consultant",
  "version": "1.0.0",
  "description": "Edge — Expert Education's internal AI assistant for consultants (Bun + LangGraph + Gemini + MongoDB Atlas)",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun run src/server.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "db:setup": "bun run scripts/setup-db.ts",
    "google:probe": "bun run scripts/google-mcp-probe.ts",
    "ingest": "bun run scripts/ingest.ts",
    "ingest:guides": "bun run scripts/ingest-guides.ts",
    "official:changes": "bun run scripts/official-changes.ts",
    "partners:sync": "bun run scripts/partners-sync.ts",
    "partners:discover": "bun run scripts/partners-discover.ts",
    "prompts:push": "bun run scripts/prompts-push.ts",
    "eval:intents": "bun run scripts/eval-intents.ts",
    "eval:coverage": "bun run scripts/eval-coverage.ts",
    "eval:golden": "bun run scripts/eval-golden.ts",
    "eval:documents": "bun run scripts/eval-documents.ts",
    "fixtures:documents": "bun run scripts/make-doc-fixtures.ts",
    "golden:build": "bun run scripts/golden-build.ts",
    "smoke": "bun run scripts/smoke.ts",
    "export:dataset": "bun run scripts/export-dataset.ts",
    "cost:report": "bun run scripts/cost-report.ts",
    "latency:report": "bun run scripts/latency-report.ts",
    "catalog:check": "bun run scripts/catalog.ts check --refs",
    "catalog:export": "bun run scripts/catalog.ts export",
    "skills:build": "bun run scripts/skills-build.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-presigned-post": "3.1149.0",
    "@langchain/aws": "1.4.6",
    "@langchain/core": "^1.2.13",
    "@langchain/google-genai": "^2.3.0",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/openai": "1.6.0",
    "@langchain/textsplitters": "^1.0.1",
    "@langfuse/client": "^5.11.0",
    "@langfuse/langchain": "^5.11.0",
    "@langfuse/otel": "^5.11.0",
    "@langfuse/tracing": "5.11.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@smithy/node-http-handler": "^4.12.1",
    "langsmith": "^0.10.1",
    "mongodb": "^6.20.0",
    "zod": "^4.5.4"
  }
}
