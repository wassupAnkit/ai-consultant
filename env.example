# ---------------------------------------------------------------------------
# Edge — AI consultant assistant (backend)
# Copy to .env for local development:  cp env.example .env
# Production values come from the Kubernetes ConfigMap + Secret (see helm/).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# APP_RELEASE=git-sha (set by CI)

# --- Persona / white-label ---------------------------------------------------
# Read directly by src/config/persona.ts (not validated by the schema below, so these
# are never required at boot). The assistant's own name. Default "Edge" if unset.
# PERSONA_NAME=Edge
# Unset (default) = the assistant names no employer and asserts no company facts as
# ground truth; company-specific facts a consultant needs come from the knowledge base.
# PERSONA_COMPANY_NAME=
# One short neutral paragraph the assistant may say about its employer. No stats or awards.
# PERSONA_COMPANY_ABOUT=

# --- Security --------------------------------------------------------------
# Static key for server-to-server callers (the Next.js frontend). >= 32 chars.
API_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Allowed browser origins for CORS (comma separated). Empty = no cross-origin browser access.
CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_RPM=60
# Whole-request budget: must exceed classify (15 s) + RESEARCH_BUDGET_MS + ANSWER_TIMEOUT_MS, and on DeepThink turns
# classify (15 s) + RESEARCH_BUDGET_MS + DEEP_THINK_TIMEOUT_MS (the server warns at boot when either does not).
# Prod: REQUEST_TIMEOUT_MS >= 15000 + RESEARCH_BUDGET_MS + DEEP_THINK_TIMEOUT_MS (120000 covers the defaults: 15 + 25 + 75 s).
# Keep the ALB idle timeout >= this.
REQUEST_TIMEOUT_MS=120000
# How long SIGTERM lets in-flight answers finish before cutting them (default REQUEST_TIMEOUT_MS + 5000; the server
# warns at boot when it is shorter than REQUEST_TIMEOUT_MS). Pod terminationGracePeriodSeconds must be >=
# preStop sleep + this + 15 s flush (prod: 15 + 125 + 15 -> 160).
# SHUTDOWN_DRAIN_MS=125000
# Normal answer budget. A reasoning answer model thinks before its first token: raise this (and REQUEST_TIMEOUT_MS) rather than turning reasoning off.
# ANSWER_TIMEOUT_MS=45000
MAX_INPUT_CHARS=4000

# End-user auth: "Continue with Google" (Google Identity Services in the frontend).
# The frontend POSTs the Google ID token to /auth/google; the backend verifies it
# against GOOGLE_OAUTH_CLIENT_ID and mints an HS256 session signed with SESSION_SECRET
# (>= 32 chars, must be the SAME value as the frontend's SESSION_SECRET).
# Sign-in is open to any verified Google account (no email-domain restriction).
# KB-admin rights (partner registry, reindex, deleting others' uploads) are
# controlled separately by ADMIN_EMAILS below -- set it explicitly in every
# deployed environment, since an empty ADMIN_EMAILS makes every signed-in user
# an admin.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
AUTH_SESSION_TTL_HOURS=12
# Legacy: Supabase-issued JWTs (pre-Google-session frontend). Leave unset.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_JWT_SECRET=only-for-legacy-HS256-projects
REQUIRE_GOOGLE_PROVIDER=true

# --- Google Gemini ---------------------------------------------------------
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
LLM_MAX_OUTPUT_TOKENS=2048
# Stream the answer model's own thought summaries to the client as `thinking` events.
# Thinking tokens are billed and delay the first answer token, so this is a flag.
GEMINI_THINKING_ENABLED=true
# GEMINI_THINKING_LEVEL=LOW                     # LOW|MEDIUM|HIGH; unset = model default
# After each answer: name the conversation (first turn) and suggest three follow-up
# questions, streamed as `session` / `suggestions` events. One or two cheap calls per turn.
TURN_EXTRAS_ENABLED=true
GEMINI_TURN_EXTRAS_MODEL=gemini-3.5-flash-lite

# --- MongoDB (Atlas in prod; `docker compose up -d mongodb` locally) -------
MONGODB_URI=mongodb://edge:edge-dev-password@localhost:57017/?directConnection=true&authSource=admin
MONGODB_DB=expert_ai_consultant
MONGODB_VECTOR_INDEX=kb_vector
MONGODB_TEXT_INDEX=kb_text
# auto = Atlas Vector Search when the indexes are ready, else in-process search
KB_SEARCH_MODE=auto
KB_CACHE_REFRESH_SECONDS=600
# Cache query embeddings (dedupes the per-source-kind fan-out; persisted in `embedding_cache`)
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_DAYS=30
# Per-pod cache of knowledge-base search results; a new ingest run or upload invalidates it. 0 = off
KB_RESULT_CACHE_TTL_SECONDS=600

# --- Conversation ----------------------------------------------------------
HISTORY_WINDOW_MESSAGES=12
SESSION_TTL_HOURS=72
RETRIEVAL_TOP_K=6
# Evidence characters placed in the answer prompt.
CONTEXT_MAX_CHARS=24000
# Per-provenance retrieval quotas (site / partner / upload / program) so partner
# sites cannot swamp experteducation.com. Empty = single-pass with RETRIEVAL_TOP_K.
RETRIEVAL_QUOTAS=site:4,partner:5,program:3,upload:4,official:3

# --- Research loop (agentic lookups at answer time) --------------------------
# After the knowledge-base search, a tool-calling model may run more lookups:
# narrower KB queries, program records, Google-grounded web search, live page
# fetch. RESEARCH_MAX_ROUNDS=0 disables the loop (knowledge base only).
# GEMINI_RESEARCH_MODEL=gemini-3.6-flash        # defaults to GEMINI_MODEL
GEMINI_WEB_SEARCH_MODEL=gemini-3.5-flash-lite
RESEARCH_MAX_ROUNDS=3
RESEARCH_BUDGET_MS=25000
RESEARCH_MAX_EVIDENCE=24
# One research model call is cut after this many ms (0 = only RESEARCH_BUDGET_MS caps it), and a round
# starts only with RESEARCH_MIN_ROUND_MS of budget left (1500 = the earlier behaviour).
RESEARCH_ROUND_TIMEOUT_MS=16000
RESEARCH_MIN_ROUND_MS=5000
# Model research rounds on an urgent turn (distress, self-harm, crisis_safeguarding); round 0 and the
# helpline searches still run. >= RESEARCH_MAX_ROUNDS = no cap (the earlier behaviour).
RESEARCH_URGENT_MAX_ROUNDS=0
# Model research rounds for a short-first question not about a person or the consultant's mail.
# >= RESEARCH_MAX_ROUNDS = no cap (the earlier behaviour).
RESEARCH_SHORT_MAX_ROUNDS=2
# Scope research tools and the round-0 search by the classified intent (src/graph/scoping.ts). false = every tool, every turn.
RESEARCH_INTENT_SCOPING=true
# Country skill packs (src/skills): research brief, answer guidance + coverage checklist, round-0 query
# vocabulary for AU/CA/NZ/UK/US. Off until the coverage eval clears them.
SKILL_PACKS_ENABLED=false
# Market packs (src/skills/markets): when the route knows the student's source market (Nepal, India,
# Bangladesh, Vietnam, Philippines, Thailand, Sri Lanka), a market brief in research and market
# guidance in the answer. Unset follows SKILL_PACKS_ENABLED; set true/false to override it.
# MARKET_PACKS_ENABLED=
# Destination facts registers (data/facts, src/skills/facts-register.ts): for a rule/fee/funds/work
# question on a destination with a register, round 0 adds its "Closed or replaced" table and the
# best-matching topic table as dated, numbered evidence.
FACTS_REGISTER_ENABLED=true
# Home-currency totals ("in NPR", "in lakh", "in our currency"): round 0 searches the source market's
# central bank (NRB, RBI, Bangladesh Bank, SBV, BSP, BOT, CBSL) for today's rate; needs web search.
FX_RATES_ENABLED=true
# Comparison fan-out: research each compared country in its own concurrent branch (same wall-clock
# budget, tools pinned to the country, no CRM/Google tools), then merge the evidence round-robin.
# Skipped for caseload work and for a named student who needs a CRM lookup.
COMPARE_FANOUT_ENABLED=false
COMPARE_MAX_COUNTRIES=3
COMPARE_BRANCH_ROUNDS=2

# Intent classifier: gemini (default) or jev. jev = TypeSafe Jev via OpenRouter decides everything in one
# ~400 ms call (Gemini classifier only on a Jev error/timeout); needs OPENROUTER_API_KEY. Also enables
# `bun run eval:intents -- --classifier jev`.
# CLASSIFIER_PROVIDER=gemini
# OPENROUTER_API_KEY=
# JEV_MODEL=typesafe/jev-1.13
# JEV_BASE_URL=https://openrouter.ai/api/v1/systemone
# JEV_TIMEOUT_MS=4000
# Answer / research models as specs: gemini:<id> or openrouter:<vendor/model>. Unset = Gemini.
# The answer fallback is always GEMINI_FALLBACK_MODEL. openrouter: specs need OPENROUTER_API_KEY.
# ANSWER_MODEL=openrouter:deepseek/deepseek-v4.1-flash
# RESEARCH_MODEL=openrouter:deepseek/deepseek-v4.1-flash
# OPENROUTER_PROVIDER={"only":["DeepInfra"],"require_parameters":true}
# DeepThink (the composer toggle): higher reasoning effort and more token headroom for that turn.
# DEEP_THINK_EFFORT=medium                      # low|medium|high (OpenRouter reasoning.effort); "high" ran ~75 s of DeepSeek reasoning and timed out (Oct 2026 audit)
# DEEP_THINK_TIMEOUT_MS=75000                   # answer budget for a DeepThink turn; REQUEST_TIMEOUT_MS caps the request
# FALLBACK_TIMEOUT_MS=25000                     # fresh budget for the fallback model when the primary fails before its first token
WEB_SEARCH_ENABLED=true
WEB_FETCH_ENABLED=true
# Extra domains Edge may fetch live besides experteducation.com and partner universities (suffix match).
# WEB_FETCH_ALLOWED_DOMAINS=homeaffairs.gov.au,gov.uk,canada.ca,immigration.govt.nz,...
# Let consultants have Edge read a URL they paste even if it is off the allowlist (SSRF-checked).
WEB_FETCH_ALLOW_EXPLICIT_URLS=true
WEB_FETCH_TIMEOUT_MS=8000
WEB_FETCH_MAX_BYTES=2000000
LIVE_CACHE_TTL_SECONDS=21600

# --- Knowledge-base administration -----------------------------------------
# Who may manage partners / reindex / delete others' uploads. Empty = any signed-in staff.
# ADMIN_EMAILS=admin@heubert.com
# Staff uploads (PDF via Gemini document understanding, TXT, MD, CSV, HTML).
UPLOAD_MAX_BYTES=20971520
UPLOAD_CONCURRENCY=2
GEMINI_PDF_MODEL=gemini-3.6-flash

# --- Student document intake (docs/document-intake/contract.md) -------------
# Counsellors attach a passport / national ID in chat; Edge reads it (one Gemini call per file)
# and proposes CRM updates as approval cards. Files are kept forever, AES-256-GCM encrypted, in
# `student_documents` + GridFS `student_files`; never in the knowledge base. Off unless all set.
STUDENT_DOCS_ENABLED=false
# STUDENT_DOC_ENC_KEY=        # openssl rand -base64 32 (its own key)
# STUDENT_DOC_ENC_KID=k1
# DOCUMENT_URL_SECRET=        # >= 32 chars; signs the 10-minute /v1/files links crm-api fetches
# PUBLIC_BASE_URL=https://edge-api.example.com   # host must be in crm-api's MCP_DOCUMENT_FETCH_HOSTS
STUDENT_DOC_MAX_BYTES=10485760
GEMINI_DOC_MODEL=gemini-3.6-flash

# --- Activity log / training data -------------------------------------------
# Every chat turn (prompt, retrieved context, answer, model, tokens, feedback) and
# every user action is written to `chat_turns` / `activity_events` for later
# fine-tuning (bun run export:dataset). No TTL by default.
ACTIVITY_LOG_ENABLED=true
ACTIVITY_RETENTION_DAYS=0
# Optional HMAC key for the pseudonymous userHash (>= 16 chars). Plain sha256 when unset.
# ACTIVITY_HASH_SECRET=

# --- Langfuse (optional: tracing, prompt management, feedback scores) ------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL=300
LANGFUSE_TRACING_ENVIRONMENT=development

# --- LangSmith (optional, read directly by the langsmith SDK) --------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=expert-ai-consultant

# --- Ingestion (bun run ingest / the Kubernetes CronJobs) ---------------------
# Curated official pages (data/official-pages.json + facts-register sources), crawled nightly.
# The user agent names us without "Bot": some government WAFs block that word although robots.txt allows the pages.
OFFICIAL_USER_AGENT="ExpertEducationEdge/1.0 (experteducation.com)"
OFFICIAL_INGEST_ENABLED=true
OFFICIAL_CRAWL_DELAY_MS=4000
# Round 0 skips the live official web search when this many indexed official chunks matched (0 = always search live).
OFFICIAL_KB_MIN_HITS=2
CRAWL_CONCURRENCY=4
CRAWL_DELAY_MS=250
# Partner-university crawls: page budget per site, sites in parallel, per-host delay.
PARTNER_DEFAULT_MAX_PAGES=400
INGEST_HOST_PARALLELISM=6
CRAWL_PARTNER_DELAY_MS=500
# Structured program records (fees, intakes, entry requirements) extracted from course pages.
PROGRAM_EXTRACTION_ENABLED=true
GEMINI_EXTRACT_MODEL=gemini-3.5-flash-lite

# --- CRM (read-only, over MCP) -----------------------------------------------
# Disabled by default (all three left unset below): this is Heubert's in-house crm-api,
# not something a white-label deployment has access to. A deployed environment that still
# has CRM_MCP_URL/CRM_EXCHANGE_SECRET/CRM_TENANT_ORIGIN set in its ConfigMap/Secret must
# have them unset there too -- this file only changes the repo-tracked example.
#
# Point Edge at crm-api's MCP endpoint to let the research loop read contacts,
# enquiries, deals and notes. URL + EXCHANGE_SECRET + TENANT_ORIGIN must be set
# together or boot fails; leave CRM_MCP_URL unset to disable CRM tools entirely.
# CRM_MCP_URL=https://pr-680-crm-api.heubertapp.com/v1/mcp
#
# Shared HMAC secret for the token exchange (crm-api POST /v1/mcp/token). Edge signs a
# short-lived assertion naming the consultant; crm-api returns THAT consultant's own token,
# so every CRM read carries their branch and assignee permissions. Must match
# MCP_EDGE_EXCHANGE_SECRET on crm-api, and must differ from SESSION_SECRET.
# CRM_EXCHANGE_SECRET=
#
# Origin header sent to crm-api. Required whenever CRM_MCP_URL is set: its VerifyAccount
# guard parses this header unguarded, and the hostname resolves the tenant. This is the
# CRM *front end* host (the tenant's company_domain), NOT the API host.
# CRM_TENANT_ORIGIN=https://pr-680-crm.heubertapp.com
#
# CRM front end origin, used to turn a CRM lookup into a link the consultant can click
# (`webUrl` on the source). Unset = CRM citations carry no link, which is the safe default:
# it must serve the SAME database as CRM_MCP_URL or every cited record 404s. Unlike
# CRM_TENANT_ORIGIN, which is only ever read as a header string, this host has to load.
# CRM_WEB_URL=https://crm.heubertapp.com
#
# Optional explicit tenant id. Omit to let crm-api resolve the tenant from Origin.
# CRM_TENANT_ID=
# CRM_TIMEOUT_MS=15000
# CRM_TOKEN_CACHE_MINUTES=10
# Offer the CRM's mutating MCP tools (crm_create_*/crm_update_*) to the research model. Keep false
# until a confirmation step exists in front of writes; the CRM has its own switch (MCP_WRITE_TOOLS_ENABLED).
# CRM_WRITE_TOOLS_ENABLED=false

# --- Google Workspace: Gmail + Drive (Google's remote MCP servers) ------------
# Each consultant connects their own Google account from the account menu; Edge stores the
# refresh token encrypted and calls gmailmcp/drivemcp.googleapis.com as that consultant.
# Needs a Web OAuth client on an INTERNAL consent screen in the Workspace org's GCP project with
# gmail.googleapis.com, drive.googleapis.com, gmailmcp.googleapis.com and drivemcp.googleapis.com
# enabled. Client id + secret + redirect URI + encryption key must be set together or boot fails.
# GOOGLE_WORKSPACE_CLIENT_ID=
# GOOGLE_WORKSPACE_CLIENT_SECRET=
# The FRONTEND's callback route, registered on the OAuth client as an authorised redirect URI.
# GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Only these email domains may link Gmail/Drive/Calendar. Independent of sign-in
# (which is open to any Google account) -- this gates whose Workspace may be connected.
GOOGLE_WORKSPACE_ALLOWED_DOMAINS=heubert.com,experteducation.com.au
# 32 random bytes (openssl rand -base64 32). Losing it disconnects everyone; must differ from SESSION_SECRET.
# GOOGLE_TOKEN_ENC_KEY=
# GOOGLE_TOKEN_ENC_KID=k1
# After a rotation, the retired keys (still accepted for decryption): k0=<base64>,k00=<base64>
# GOOGLE_TOKEN_ENC_PREVIOUS_KEYS=
# GMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp/v1
# DRIVE_MCP_URL=https://drivemcp.googleapis.com/mcp/v1
# GOOGLE_WORKSPACE_TIMEOUT_MS=15000
# auto (default): Google's MCP servers, falling back to the Gmail/Drive REST APIs while the MCP
# developer preview refuses this Cloud project. rest: never the preview servers. mcp: no fallback.
# GOOGLE_WORKSPACE_TRANSPORT=auto
# Offer Gmail drafts as approval cards. A draft is saved only on Approve and is never sent.
# GMAIL_DRAFTS_ENABLED=false
